{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "workspace-audit report (plugin 0.4.x, report schema_version 1.0)",
  "description": "Shape of scan.json produced by skills/workspace-audit/scripts/audit_scan.py. Pragmatic: unknown top-level keys are allowed (additionalProperties stays true) so enrich stages can add facts without a schema bump. Secret values are never modeled: secrets carry path/kind/mask/fingerprint only, and additionalProperties is false there so a 'value' or 'preview' key carrying raw material cannot validate.",
  "type": "object",
  "required": [
    "schema_version",
    "root",
    "home",
    "generated_at",
    "rules_version",
    "stats",
    "gates",
    "findings_detailed",
    "secrets",
    "top_level",
    "junk"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "root": { "type": "string" },
    "home": { "type": "string" },
    "generated_at": { "type": "string" },
    "rules_version": { "type": "string" },
    "stats": {
      "type": "object",
      "required": [
        "total_files",
        "total_size_bytes",
        "skipped_symlinks_outside",
        "duration_sec"
      ],
      "properties": {
        "total_files": { "type": "number" },
        "total_size_bytes": { "type": "number" },
        "skipped_symlinks_outside": { "type": "number" },
        "duration_sec": { "type": "number" }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gid", "n", "status"],
        "properties": {
          "gid": { "type": "string" },
          "n": { "type": "number" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "warn", "unknown", "not_applicable"] },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rule": { "type": "string" },
                "status": { "type": "string", "enum": ["pass", "fail", "warn", "unknown", "not_applicable"] }
              }
            }
          },
          "pass_when": { "type": "string" },
          "fail_when": { "type": "string" },
          "warn_when": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": ["string", "object"] } },
          "confidence": { "type": "number" },
          "recommendation": { "type": "string" },
          "doc_ref": { "type": "string" }
        }
      }
    },
    "findings_detailed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fid", "gate", "category", "severity", "status", "title", "evidence", "recommendation"],
        "properties": {
          "fid": { "type": "string" },
          "gate": { "type": "string" },
          "category": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "status": { "type": "string", "enum": ["pass", "fail", "warn", "unknown", "not_applicable"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": ["string", "object"] } },
          "confidence": { "type": "number" },
          "recommendation": { "type": "string" },
          "autofix_available": { "type": "boolean" },
          "schema_version": { "type": "string" }
        }
      }
    },
    "secrets": {
      "type": "array",
      "description": "Detections carry only a mask and a fingerprint. Raw values must never appear in a report; additionalProperties=false rejects any attempt to add e.g. a 'value' or 'preview' key.",
      "items": {
        "type": "object",
        "required": ["path", "kind", "fingerprint"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "line": { "type": "number" },
          "kind": { "type": "string" },
          "mask": { "type": "string" },
          "fingerprint": { "type": "string" },
          "confidence": { "type": "number" }
        }
      }
    },
    "top_level": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["repo", "dir", "file"] },
          "git": { "type": ["object", "null"] },
          "size_bytes": { "type": "number" },
          "extra": { "type": "object" }
        }
      }
    },
    "junk": {
      "type": "object",
      "required": ["files", "dirs", "empty_dirs"],
      "properties": {
        "files": { "type": "array" },
        "dirs": { "type": "array" },
        "empty_dirs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "findings": {
      "type": "array",
      "description": "Fingerprinted findings (stable fp + section + path) used for baseline diffs.",
      "items": {
        "type": "object",
        "required": ["fp"],
        "properties": {
          "fp": { "type": "string" },
          "section": { "type": "string" },
          "path": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] }
        }
      }
    },
    "duplicates": { "type": "array" },
    "large_files": { "type": "array" }
  }
}
